{
  "name": "vincodelab",
  "productName": "VincodeLab",
  "description": "Workbench macOS per workspace, coding agent, editor, terminale, Git, GitHub, database e Redis.",
  "author": "Vincenzo Di Mauro",
  "private": true,
  "version": "0.1.2",
  "license": "MIT",
  "homepage": "https://github.com/dimaurovincenzo/VincodeLab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimaurovincenzo/VincodeLab.git"
  },
  "bugs": {
    "url": "https://github.com/dimaurovincenzo/VincodeLab/issues"
  },
  "keywords": [
    "coding-agent",
    "developer-tools",
    "electron",
    "macos",
    "redis",
    "workspace"
  ],
  "type": "module",
  "main": "electron/app/bootstrap.cjs",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.12.0 <27",
    "npm": ">=10.9.0 <12"
  },
  "scripts": {
    "prepare": "panda codegen && node scripts/build-preload.mjs",
    "panda": "panda",
    "predev": "npm run build:preload",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "prestart": "npm run build:preload",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps && node scripts/ensure-node-pty-spawn-helper.cjs",
    "prebuild": "node scripts/build-preload.mjs && node scripts/ensure-node-pty-spawn-helper.cjs",
    "build": "tsc -b && vite build",
    "build:preload": "node scripts/build-preload.mjs",
    "check:preload": "node scripts/build-preload.mjs --check",
    "lint": "oxlint --import-plugin",
    "test": "node --test test/*.test.cjs test/*.test.mjs && npm run test:components",
    "test:components": "vitest run --config vitest.config.ts",
    "check": "npm run check:repo && npm run check:architecture && npm run check:preload && npm run lint && npm run audit:css:check && npm test && npm run build",
    "check:repo": "node scripts/check-repository.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "demo:create": "node scripts/create-demo-workspace.mjs",
    "screenshots:capture": "node scripts/capture-app-screenshots.mjs",
    "audit:css": "node scripts/audit-css.mjs",
    "audit:css:check": "node scripts/audit-css.mjs --check",
    "benchmark:terminal": "node scripts/benchmark-terminal-stream.mjs",
    "benchmark:reliability": "node scripts/benchmark-reliability.mjs",
    "stress:architecture": "node scripts/architecture-soak.mjs --profile full",
    "stress:architecture:smoke": "node scripts/architecture-soak.mjs --profile smoke",
    "preview": "vite preview",
    "rebuild:native": "electron-builder install-app-deps && node scripts/ensure-node-pty-spawn-helper.cjs",
    "package": "npm run build && npm run rebuild:native && electron-builder --mac"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "mysql2": "^3.24.2",
    "node-pty": "^1.1.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "tedious": "^20.0.0",
    "yaml": "^2.9.0"
  },
  "build": {
    "appId": "com.vincodelab.app",
    "productName": "VincodeLab",
    "afterPack": "./scripts/ensure-node-pty-spawn-helper.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist/icons.svg",
      "dist/vincodelab-icon.png",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/pi",
        "to": "pi"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "identity": null
    }
  },
  "devDependencies": {
    "@ark-ui/react": "^5.39.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@iconify-icons/vscode-icons": "^1.2.30",
    "@iconify/react": "^6.0.2",
    "@lezer/highlight": "^1.2.3",
    "@pandacss/dev": "^1.12.0",
    "@replit/codemirror-minimap": "^0.5.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql-formatter": "^15.8.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
